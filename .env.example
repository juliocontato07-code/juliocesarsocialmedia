# Copie para .env e preencha. O .env nunca entra no repositório.

# Connection string do Postgres (Neon). Exige SSL.
DATABASE_URL=

# Segredo dos cookies de sessão. Use um valor longo e aleatório.
SESSION_SECRET=

# Usadas UMA ÚNICA VEZ, na criação do primeiro administrador.
# Havendo qualquer usuário no banco, são ignoradas.
ADMIN_USUARIO=
ADMIN_SENHA=

# Porta do servidor. Padrão 3000.
PORT=3000
