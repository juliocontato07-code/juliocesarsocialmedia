# Copie para .env e preencha. O .env nunca entra no repositório.

# Connection string do Postgres (Neon). Exige SSL.
DATABASE_URL=

# Segredo dos cookies de sessão. Use um valor longo e aleatório.
SESSION_SECRET=

# Usadas UMA ÚNICA VEZ, na criação do primeiro administrador.
# Havendo qualquer usuário no banco, são ignoradas.
ADMIN_USUARIO=
ADMIN_SENHA=

# Chave do cofre de acessos: 32 bytes, em hexadecimal (64 caracteres) ou
# base64 (44). É ela que cifra e decifra as senhas das contas dos clientes.
#
# Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Sem ela o app sobe normalmente, mas o bloco de Acessos avisa que o cofre
# está indisponível e nenhuma gravação é aceita. Trocar a chave depois de já
# haver senhas gravadas torna todas elas ilegíveis: não há como recuperá-las
# sem a chave que as cifrou.
CREDENTIALS_KEY=

# Porta do servidor. Padrão 3000.
PORT=3000
